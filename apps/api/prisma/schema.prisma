generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  seller
  support
  admin
}

enum StorePlan {
  free
  pro
}

enum StoreStatus {
  active
  suspended
}

enum CurrencyCode {
  CUP
  USD
  MLC
}

enum OrderChannel {
  whatsapp
  telegram
}

enum OrderStatus {
  created
  confirmed
  preparing
  dispatched
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  proof_submitted
  paid
  failed
  refunded
}

enum PaymentMethodType {
  cash
  transfermovil
  enzona
  bank_transfer
  other
}

enum PaymentProviderType {
  manual
  enzona
  transfermovil
}

enum PaymentTransactionStatus {
  pending
  authorized
  completed
  failed
  cancelled
  refunded
}

enum SubscriptionStatus {
  pending
  approved
  rejected
}

enum DiscountType {
  percent
  fixed
}

enum PromotionType {
  percent
  min_amount
  bogo_2x1
  bogo_3x2
  second_unit
  combo
}

enum ReportTargetType {
  store
  product
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

// ============================================================================
// MODELOS
// ============================================================================

model Profile {
  id              String    @id @db.Uuid
  email           String    @unique @db.VarChar(160)
  displayName     String    @map("display_name") @db.VarChar(100)
  phone           String?   @db.VarChar(24)
  role            UserRole  @default(seller)
  termsVersion    String    @map("terms_version") @db.VarChar(32)
  acceptedTermsAt DateTime  @map("accepted_terms_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  stores                Store[]
  subscriptionRequests  SubscriptionRequest[] @relation("SubscriptionRequester")
  reviewedSubscriptions SubscriptionRequest[] @relation("SubscriptionReviewer")
  reviewedReports       Report[]              @relation("ReportReviewer")
  orderStatusChanges    OrderStatusHistory[]
  auditLogs             AuditLog[]

  @@index([role])
  @@map("profiles")
}

model Store {
  id                 String         @id @default(uuid()) @db.Uuid
  ownerId            String         @map("owner_id") @db.Uuid
  slug               String         @unique @db.VarChar(60)
  name               String         @db.VarChar(100)
  category           String         @db.VarChar(60)
  description        String?        @db.VarChar(500)
  whatsapp           String         @db.VarChar(24)
  telegram           String?        @db.VarChar(64)
  province           String?        @db.VarChar(60)
  municipality       String?        @db.VarChar(60)
  streetAddress      String?        @map("street_address") @db.VarChar(220)
  hours              Json?          @db.JsonB
  theme              Json?          @db.JsonB
  baseCurrency       CurrencyCode   @default(CUP) @map("base_currency")
  acceptedCurrencies CurrencyCode[] @default([CUP]) @map("accepted_currencies")
  exchangeRates      Json           @map("exchange_rates") @db.JsonB
  ratesUpdatedAt     DateTime?      @map("rates_updated_at") @db.Timestamptz(6)
  freeShippingMin    Decimal?       @map("free_shipping_min") @db.Decimal(12, 2)
  pickupEnabled      Boolean        @default(false) @map("pickup_enabled")
  plan               StorePlan      @default(free)
  planExpiresAt      DateTime?      @map("plan_expires_at") @db.Timestamptz(6)
  status             StoreStatus    @default(active)
  suspendedReason    String?        @map("suspended_reason") @db.VarChar(240)
  orderSeq           Int            @default(0) @map("order_seq")
  cacheVersion       Int            @default(1) @map("cache_version")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner                Profile                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  categories           Category[]
  products             Product[]
  shippingZones        ShippingZone[]
  orders               Order[]
  paymentMethods       PaymentMethod[]
  paymentTransactions  PaymentTransaction[]
  paymentCredentials   StorePaymentCredential[]
  subscriptionRequests SubscriptionRequest[]
  coupons              Coupon[]
  promotions           Promotion[]
  reports              Report[]
  analyticsDaily       AnalyticsDaily[]

  @@index([ownerId])
  @@index([status, plan])
  @@map("stores")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  schedule  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products   Product[]
  promotions Promotion[]

  @@index([storeId, sortOrder])
  @@map("categories")
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  storeId        String       @map("store_id") @db.Uuid
  categoryId     String?      @map("category_id") @db.Uuid
  name           String       @db.VarChar(120)
  description    String?      @db.VarChar(1200)
  price          Decimal      @db.Decimal(12, 2)
  compareAtPrice Decimal?     @map("compare_at_price") @db.Decimal(12, 2)
  currency       CurrencyCode @default(CUP)
  stock          Int?
  active         Boolean      @default(true)
  soldOut        Boolean      @default(false) @map("sold_out")
  sortOrder      Int          @default(0) @map("sort_order")
  images         Json         @default("[]") @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  orderItems OrderItem[]
  reports    Report[]

  @@index([storeId, active, sortOrder])
  @@index([storeId, categoryId])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  label         String   @db.VarChar(100)
  sku           String?  @db.VarChar(64)
  attributes    Json     @db.JsonB
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  stock         Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId, active])
  @@map("product_variants")
}

model ShippingZone {
  id           String       @id @default(uuid()) @db.Uuid
  storeId      String       @map("store_id") @db.Uuid
  province     String       @db.VarChar(60)
  municipality String?      @db.VarChar(60)
  cost         Decimal      @db.Decimal(12, 2)
  currency     CurrencyCode @default(CUP)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, province, municipality])
  @@map("shipping_zones")
}

model PaymentMethod {
  id           String            @id @default(uuid()) @db.Uuid
  storeId      String            @map("store_id") @db.Uuid
  type         PaymentMethodType
  label        String            @db.VarChar(80)
  currencies   CurrencyCode[]
  instructions String?           @db.VarChar(400)
  accountData  String?           @map("account_data") @db.VarChar(160)
  enabled      Boolean           @default(true)
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([storeId, enabled, sortOrder])
  @@map("payment_methods")
}

model StorePaymentCredential {
  id               String              @id @default(uuid()) @db.Uuid
  storeId          String              @map("store_id") @db.Uuid
  provider         PaymentProviderType
  encryptedPayload String              @map("encrypted_payload") @db.Text
  keyVersion       Int                 @default(1) @map("key_version")
  sandbox          Boolean             @default(true)
  hintLast4        String?             @map("hint_last4") @db.VarChar(8)
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@map("store_payment_credentials")
}

model Order {
  id               String        @id @default(uuid()) @db.Uuid
  storeId          String        @map("store_id") @db.Uuid
  orderNumber      Int           @map("order_number")
  trackingToken    String        @unique @map("tracking_token") @db.VarChar(64)
  status           OrderStatus   @default(created)
  paymentStatus    PaymentStatus @default(pending) @map("payment_status")
  channel          OrderChannel  @default(whatsapp)
  paymentMethodId  String?       @map("payment_method_id") @db.Uuid
  paymentLabel     String        @map("payment_label") @db.VarChar(80)
  fulfillmentType  String        @map("fulfillment_type") @db.VarChar(20)
  shippingZoneName String?       @map("shipping_zone_name") @db.VarChar(120)
  customerSnapshot Json          @map("customer_snapshot") @db.JsonB
  currency         CurrencyCode
  subtotal         Decimal       @db.Decimal(12, 2)
  discountTotal    Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingCost     Decimal       @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  cashTendered     Decimal?      @map("cash_tendered") @db.Decimal(12, 2)
  cashChange       Decimal?      @map("cash_change") @db.Decimal(12, 2)
  couponCode       String?       @map("coupon_code") @db.VarChar(40)
  receiptObjectKey String?       @map("receipt_object_key") @db.VarChar(255)
  cancelReason     String?       @map("cancel_reason") @db.VarChar(240)
  idempotencyKey   String?       @map("idempotency_key") @db.VarChar(80)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  paymentMethod       PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  paymentTransactions PaymentTransaction[]

  @@unique([storeId, orderNumber])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, status])
  @@map("orders")
}

model OrderItem {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  productId    String?      @map("product_id") @db.Uuid
  variantId    String?      @map("variant_id") @db.Uuid
  productName  String       @map("product_name") @db.VarChar(120)
  variantLabel String?      @map("variant_label") @db.VarChar(100)
  unitPrice    Decimal      @map("unit_price") @db.Decimal(12, 2)
  currency     CurrencyCode
  quantity     Int
  lineTotal    Decimal      @map("line_total") @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  note        String?      @db.VarChar(240)
  changedById String?      @map("changed_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy Profile? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model PaymentTransaction {
  id                    String                   @id @default(uuid()) @db.Uuid
  orderId               String                   @map("order_id") @db.Uuid
  storeId               String                   @map("store_id") @db.Uuid
  provider              PaymentProviderType
  status                PaymentTransactionStatus @default(pending)
  amount                Decimal                  @db.Decimal(12, 2)
  currency              CurrencyCode
  refundedAmount        Decimal                  @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  idempotencyKey        String                   @unique @map("idempotency_key") @db.VarChar(96)
  externalTransactionId String?                  @map("external_transaction_id") @db.VarChar(128)
  confirmUrl            String?                  @map("confirm_url") @db.VarChar(500)
  providerStatusCode    String?                  @map("provider_status_code") @db.VarChar(40)
  failureReason         String?                  @map("failure_reason") @db.VarChar(240)
  reconcileAttempts     Int                      @default(0) @map("reconcile_attempts")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([storeId, status])
  @@index([provider, externalTransactionId])
  @@index([status, updatedAt])
  @@map("payment_transactions")
}

model PlansConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  key                 String   @unique @db.VarChar(32)
  freeLimits          Json     @map("free_limits") @db.JsonB
  proLimits           Json     @map("pro_limits") @db.JsonB
  proPriceCup         Decimal  @map("pro_price_cup") @db.Decimal(12, 2)
  proPriceUsd         Decimal  @map("pro_price_usd") @db.Decimal(12, 2)
  proDurationDays     Int      @map("pro_duration_days")
  paymentInstructions String   @map("payment_instructions") @db.VarChar(600)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("plans_config")
}

model SubscriptionRequest {
  id                 String             @id @default(uuid()) @db.Uuid
  storeId            String             @map("store_id") @db.Uuid
  profileId          String             @map("profile_id") @db.Uuid
  targetPlan         StorePlan          @default(pro) @map("target_plan")
  durationDays       Int                @map("duration_days")
  amount             Decimal            @db.Decimal(12, 2)
  currency           CurrencyCode
  paymentMethodLabel String             @map("payment_method_label") @db.VarChar(60)
  reference          String             @db.VarChar(80)
  receiptObjectKey   String             @map("receipt_object_key") @db.VarChar(255)
  status             SubscriptionStatus @default(pending)
  rejectionReason    String?            @map("rejection_reason") @db.VarChar(240)
  reviewedById       String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requester  Profile  @relation("SubscriptionRequester", fields: [profileId], references: [id], onDelete: Restrict)
  reviewedBy Profile? @relation("SubscriptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([storeId])
  @@map("subscription_requests")
}

model Coupon {
  id             String       @id @default(uuid()) @db.Uuid
  storeId        String       @map("store_id") @db.Uuid
  code           String       @db.VarChar(40)
  discountType   DiscountType @map("discount_type")
  discountValue  Decimal      @map("discount_value") @db.Decimal(12, 2)
  currency       CurrencyCode @default(CUP)
  minOrderAmount Decimal      @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime     @map("ends_at") @db.Timestamptz(6)
  maxUses        Int?         @map("max_uses")
  usedCount      Int          @default(0) @map("used_count")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId, active])
  @@map("coupons")
}

model Promotion {
  id            String        @id @default(uuid()) @db.Uuid
  storeId       String        @map("store_id") @db.Uuid
  categoryId    String?       @map("category_id") @db.Uuid
  name          String        @db.VarChar(100)
  type          PromotionType
  discountValue Decimal       @default(0) @map("discount_value") @db.Decimal(12, 2)
  minAmount     Decimal       @default(0) @map("min_amount") @db.Decimal(12, 2)
  productIds    String[]      @default([]) @map("product_ids") @db.Uuid
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([storeId, active])
  @@map("promotions")
}

model Report {
  id              String           @id @default(uuid()) @db.Uuid
  storeId         String           @map("store_id") @db.Uuid
  productId       String?          @map("product_id") @db.Uuid
  targetType      ReportTargetType @map("target_type")
  reason          String           @db.VarChar(80)
  details         String           @db.VarChar(500)
  reporterContact String?          @map("reporter_contact") @db.VarChar(120)
  status          ReportStatus     @default(open)
  resolutionNote  String?          @map("resolution_note") @db.VarChar(300)
  reviewedById    String?          @map("reviewed_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  reviewedBy Profile? @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([storeId])
  @@map("reports")
}

model AnalyticsDaily {
  id      String   @id @default(uuid()) @db.Uuid
  storeId String   @map("store_id") @db.Uuid
  day     DateTime @db.Date
  visits  Int      @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, day])
  @@map("analytics_daily")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role") @db.VarChar(24)
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(48)
  entityId   String   @map("entity_id") @db.VarChar(64)
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

model SupportTicket {
  id        String              @id @default(uuid()) @db.Uuid
  name      String              @db.VarChar(100)
  contact   String              @db.VarChar(120)
  channel   String              @default("whatsapp") @db.VarChar(20)
  storeSlug String?             @map("store_slug") @db.VarChar(60)
  topic     String              @db.VarChar(120)
  message   String              @db.VarChar(1500)
  status    SupportTicketStatus @default(open)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@map("support_tickets")
}


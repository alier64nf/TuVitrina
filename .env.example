# ==============================================================================
# TuVitrina - Variables de entorno (NO guardar secretos reales en el repositorio)
# ==============================================================================

# --- PostgreSQL (Supabase o contenedor local) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tuvitrina?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tuvitrina?schema=public"

# --- Redis (Upstash o contenedor local; degradación elegante si no está disponible) ---
REDIS_URL="redis://localhost:6379"

# --- Supabase Auth & Storage (servidor) ---
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWKS_URL=""
SUPABASE_JWT_ISSUER=""
SUPABASE_STORAGE_BUCKET_PRODUCTS="product-images"
SUPABASE_STORAGE_BUCKET_ASSETS="store-assets"
SUPABASE_STORAGE_BUCKET_RECEIPTS="receipts"

# --- Seguridad & Cifrado (solo servidor) ---
# Clave hexadecimal de 64 caracteres (32 bytes) para AES-256-GCM
MASTER_ENCRYPTION_KEY=""
CORS_ORIGINS="http://localhost:3000"
API_PORT="3001"
NODE_ENV="development"

# --- Términos y privacidad ---
TERMS_VERSION="2026-11-v1"

# --- Pasarelas de pago (fases posteriores, solo servidor) ---
ENZONA_SANDBOX="true"
ENZONA_API_BASE="https://api.enzona.net"

# --- Frontend público (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_TERMS_VERSION="2026-11-v1"
